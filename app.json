{
  "expo": {
    "name": "Träningslogg",
    "slug": "traningslogg",
    "version": "1.2.0",
    "scheme": "traningslogg",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0f0f13"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f0f13"
      },
      "package": "com.hollan75.traningslogg",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.USE_EXACT_ALARM",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hollan75.traningslogg"
    },
    "extra": {
      "eas": {
        "projectId": "e32a2664-5393-4229-9724-eeb9cd6981a3"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#7b6cff"
        }
      ]
    ]
  }
}
